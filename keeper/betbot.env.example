# The testnet market-making bot. Install as /etc/updown/betbot.env with mode 0600, owner updown.
#
# This file carries SIGNING KEYS for the two demo-liquidity accounts. They are chain-97 only — the
# bot refuses to start on any other chain id, and refuses any key that collides with the keeper or
# the owner, because a second sender on those accounts races their nonces.

RPC_URL=https://data-seed-prebsc-1-s1.bnbchain.org:8545

# The two bettor accounts. Never commit real values.
# Public addresses, for cross-checking against BOT_ADDRESSES in monitor.env/daily-report.env:
#   A = 0xFe1F5E099A7960e0100afBEF97262CF0aC9E30cC
#   B = 0x4DFD9dDb28cECF5fA0b99B5291E91D783D51E342
A_KEY=
B_KEY=

# Which markets to make. Gas is proportional to FUNDED ROUNDS, not to configured markets — an
# unfunded market costs nothing — so this is the single dial that sets the burn:
#   btcUsd10m only      144 rounds/day    ~0.0107 tBNB/day
#   the three 10m       432 rounds/day    ~0.0322 tBNB/day
#   all six            ~2518 rounds/day   ~0.188  tBNB/day (measured, at the fill the bot achieves)
# Testnet gas comes only from a captcha-gated faucet a human must clear, so this is deliberately
# narrow. Continuity matters more than size: stake range is free, market count is not.
MARKETS=btcUsd10m

# Stake range in USDT. Costs NO gas to raise — a bigger bet is the same transaction — so this is
# the cheap dial for a deeper-looking book. Defaults: 3 / 12.
BET_MIN=3
BET_MAX=12

# Tops the two bot accounts AND the keeper up with gas when they run low, so the board keeps
# running between human faucet claims. Without it the bot still bets; it just asks for a claim
# instead of moving money itself, and nothing tops the keeper up either.
#
# This is texas-h5's BNB-testnet billing wallet key (payer 0xE6b9a3895Ab013A1E82909f175f13D35400c6200),
# shared across both projects by owner ruling 2026-09-05: "混着用也没事 因为texas-h5 测试环境只有我自己用".
# It is chain-97 only in this process — bet-bot.mjs refuses any other chain id — but the same
# address does hold real BNB on mainnet, which is what qualifies it for the faucet. Treat the file
# as key material: mode 0600, owner updown, never in git, never echoed to a log.
FUNDER_KEY=

MIN_GAS_BNB=0.01
GAS_TOPUP_BNB=0.05
# MUST stay strictly ABOVE the keeper floor the watchdog and the daily report alarm on (both 0.05),
# or the top-up only fires once the page has already gone out. 0.08 is the code default and leaves
# the refill three hundredths of headroom to run first.
KEEPER_MIN_GAS_BNB=0.08
KEEPER_TARGET_GAS_BNB=0.17
FUNDER_RESERVE_BNB=0.01
GAS_REFILL_MAX_AGE_HOURS=24

# macOS-only nicety that opens the faucet page in a browser; there is no browser here.
OPEN_FAUCET_ON_DUE=0
