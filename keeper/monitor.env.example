# Out-of-process UpDown watchdog. Install as /etc/updown/monitor.env with mode 0600, owner updown.
# It intentionally does NOT contain KEEPER_PRIVATE_KEY.
RPC_URL=https://data-seed-prebsc-1-s1.bnbchain.org:8545
DEPLOYMENTS_PATH=/etc/updown/97.json
KEEPER_HEALTH_URL=http://127.0.0.1:9464/healthz

# Public operational addresses, comma-separated.
BOT_ADDRESSES=0xFe1F5E099A7960e0100afBEF97262CF0aC9E30cC,0x4DFD9dDb28cECF5fA0b99B5291E91D783D51E342
FUNDER_ADDRESS=0xE6b9a3895Ab013A1E82909f175f13D35400c6200

# Dedicated @bluff_alert_bot destination. Never commit real values.
ALERT_TELEGRAM_BOT_TOKEN=
ALERT_TELEGRAM_CHAT_ID=
ALERT_ENV_LABEL=prod

KEEPER_MIN_GAS_BNB=0.05
BOT_MIN_GAS_BNB=0.01
FUNDER_RESERVE_BNB=0.01
UPDOWN_ALERT_REPEAT_SECONDS=3600
# Set false to pause watchdog Telegram failure/reminder/recovery messages while the testnet faucet
# is unavailable. Checks, error exit status, browser digests and bot gas protection remain active.
UPDOWN_WATCHDOG_ALERTS_ENABLED=true
# A keeper build that reports no market addresses cannot be checked against DEPLOYMENTS_PATH; it is
# noted, and becomes a failure once it has been running unverified for longer than this.
UPDOWN_UNVERIFIED_GRACE_SECONDS=600
# Page when NO market anywhere has carried an internal stake for this long — the betting bot has
# stopped. Board-wide on purpose: the bot is routinely narrowed to one market to stretch gas, so
# five silent markets are the designed steady state, and only total silence means it is gone.
# Nothing else here can see it — a dead bot spends no gas, so it drifts ABOVE its floor, and
# settles nothing, so /healthz stays green. 0 stands the check down for a deliberate pause.
# Default: 3600 (~6 dry 10m rounds); values under 600 are refused as too tight for one 10m round.
UPDOWN_MARKET_MAKING_MAX_IDLE_SECONDS=3600
# Page when too many recently closed rounds carried stake on ONE side only. The betting bot splits
# the two sides of a round across its two accounts, so ONE account running out of gas leaves ~95% of
# rounds with an empty side — the contract voids those and refunds every stake at zero fee, taking
# protocol revenue to zero board-wide. Nothing else here can see it: one-sided is a benign void so
# /healthz stays 200, and the idle check above is a board-wide minimum that the account which still
# has gas keeps near zero. On 2026-09-05 that state ran behind an all-green board.
# The bot places a one-sided book on purpose ~5% of the time, so 0.5 sits an order of magnitude
# above the design and well below the ~95% a dead account produces. 0 switches the check off.
UPDOWN_ONE_SIDED_MAX_RATIO=0.5
# Closed rounds examined per market, newest first.
UPDOWN_ONE_SIDED_WINDOW=20
# Staked rounds needed before the ratio may page. A board narrowed to one market to stretch gas
# produces few rounds an hour, and two deliberate one-sided books out of three is not evidence.
UPDOWN_ONE_SIDED_MIN_SAMPLE=8
# How recently a round must have closed to be judged. This is what makes a narrowed board readable:
# a market the bot stops covering also stops advancing its epoch, so its newest stored rounds would
# otherwise stay in the sample for ever — healthy history hiding a real outage, or one-sided history
# paging long after the board was repaired. 14400s keeps a covered 10m market's whole 20-round
# window (200 min) while dropping a dormant market out of the sample within a few hours. 0 disables.
UPDOWN_ONE_SIDED_MAX_AGE_SECONDS=14400

# ── browser-error digests ────────────────────────────────────────────────────
# The web app posts error signatures to the keeper's POST /client-error (see CLIENT_ERROR_REPORTS
# in the keeper env); this watchdog turns them into at most one Telegram digest per cooldown.
#
# Its own lane on purpose. A browser error says nothing about whether the keeper is running, the
# markets are ticking or the gas rails are funded, so it never flips the verdict, never opens or
# closes an incident, and never consumes the incident alert slot. The cooldown is the whole abuse
# answer: however many reports arrive, they collapse into one message per window before anything is
# sent, so a page that breaks for every visitor cannot crowd out an outage page.
# 0 stands the lane down. Values between 1 and 59 are refused as too tight for that guarantee.
UPDOWN_CLIENT_ALERT_COOLDOWN_SECONDS=3600
UPDOWN_CLIENT_ALERT_THRESHOLD=1
