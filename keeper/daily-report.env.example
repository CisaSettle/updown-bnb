# Once-a-day UpDown market report. Install as /etc/updown/daily-report.env with mode 0600, owner
# updown. Like monitor.env it intentionally does NOT contain KEEPER_PRIVATE_KEY: the report only
# reads contract views.
#
# Every variable dist/daily-report.js reads is listed here with its real default.

# Required. Public BSC testnet data-seed node; the report uses views only, never eth_getLogs.
RPC_URL=https://data-seed-prebsc-1-s1.bnbchain.org:8545
# Deployment manifest naming the six markets plus operator/owner. Default: /etc/updown/97.json
DEPLOYMENTS_PATH=/etc/updown/97.json
# Durable "this day was already delivered" marker, so a Persistent=true catch-up cannot double-send.
# Default: /var/lib/updown-daily-report/state.json — the unit already sets it, keep them in step.
UPDOWN_REPORT_STATE_PATH=/var/lib/updown-daily-report/state.json
# Which local calendar day the epoch grid is cut on. Minutes east of UTC, -720..840.
# Default: 480 (UTC+8).
UPDOWN_REPORT_UTC_OFFSET_MINUTES=480
# Label printed in the report header. Default: testnet (note: monitor.env defaults to prod).
ALERT_ENV_LABEL=testnet

# Dedicated @bluff_alert_bot destination. Never commit real values.
# ALERT_TELEGRAM_BOT_TOKEN falls back to TELEGRAM_BOT_TOKEN; both are required unless
# UPDOWN_REPORT_DRY_RUN is on, and so is ALERT_TELEGRAM_CHAT_ID.
ALERT_TELEGRAM_BOT_TOKEN=
ALERT_TELEGRAM_CHAT_ID=

# Public operational addresses, comma-separated. Stake from these is "internal", everything else is
# counted as a real user, so an address missing here inflates the real-user number.
# The keeper/operator and the owner are read from DEPLOYMENTS_PATH and never need listing.
# All three default to empty.
BOT_ADDRESSES=0xFe1F5E099A7960e0100afBEF97262CF0aC9E30cC,0x4DFD9dDb28cECF5fA0b99B5291E91D783D51E342
FUNDER_ADDRESS=0xE6b9a3895Ab013A1E82909f175f13D35400c6200
# Anything else this project runs, added without a redeploy.
UPDOWN_INTERNAL_ADDRESSES=

# tBNB floors reported in the gas section at send time. The funder is compared as "keep above".
BOT_MIN_GAS_BNB=0.01
KEEPER_MIN_GAS_BNB=0.05
FUNDER_RESERVE_BNB=0.01
# Optional. Unset means the report simply omits the keeper /healthz line. Default: unset.
KEEPER_HEALTH_URL=http://127.0.0.1:9464/healthz

# Operator overrides, all off by default — leave them empty in production.
# YYYY-MM-DD to re-render one specific day; it also bypasses the once-a-day state file and does not
# write it, so a backfill cannot mark today as sent. Default: unset (yesterday, local).
UPDOWN_REPORT_DATE=
# 1/true/yes/on prints the report to the journal instead of sending it, and needs no credentials.
UPDOWN_REPORT_DRY_RUN=
# 1/true/yes/on drops the day-over-day comparison, halving the run time. Default: comparison on.
UPDOWN_REPORT_SKIP_COMPARISON=
