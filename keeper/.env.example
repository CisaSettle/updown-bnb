# ─────────────────────────────────────────────────────────────────────────────
# UpDown keeper — copy to .env and fill in. Only the first three are required.
# ─────────────────────────────────────────────────────────────────────────────

# 56 = BNB Smart Chain mainnet, 97 = BSC testnet.
CHAIN_ID=97

# JSON-RPC endpoint. Defaults to the chain's public node if left blank.
#   mainnet: https://bsc-dataseed1.bnbchain.org
#   testnet: https://data-seed-prebsc-1-s1.bnbchain.org:8545
RPC_URL=https://data-seed-prebsc-1-s1.bnbchain.org:8545

# 32-byte hex key of the keeper account (0x prefix optional).
# executeRound() is permissionless, so this key needs NO market privilege — it only needs BNB for
# gas, and on testnet it must be the `updater` of the RelayAggregator feeds (the OPERATOR address
# passed to the deploy script). NEVER put a key with funds beyond gas here.
KEEPER_PRIVATE_KEY=

# ── optional ────────────────────────────────────────────────────────────────

# Path to the deployments JSON. Default: ../contracts/deployments/<CHAIN_ID>.json
# DEPLOYMENTS_PATH=/etc/updown/97.json

# Spot price source for testnet relay feeds. No API key required.
# PRICE_API=https://api.binance.com/api/v3/ticker/price
# PRICE_API_FALLBACKS=https://data-api.binance.vision/api/v3/ticker/price
# PRICE_TIMEOUT_MS=4000
# PRICE_CACHE_TTL_MS=1500
# PRICE_MAX_DEVIATION_BPS=2000
# SYMBOL_MAP={"BTC / USD":"BTCUSDT"}

# debug | info | warn | error
# LOG_LEVEL=info

# HTTP server for /healthz and /metrics. 0 disables it.
# METRICS_PORT=9464
# METRICS_HOST=0.0.0.0

# Error reports from the web app: POST /client-error, the only input this process accepts. OFF by
# default, and while off the route 404s like any other path — it does not exist rather than existing
# and refusing. The browser is the only witness to a failure the node refused before it ever reached
# the mempool, which is why this exists at all; the keeper only COUNTS, never sends, so the Telegram
# credentials stay in /etc/updown/monitor.env and never enter this file beside the signing key.
# Reaching it needs a TLS front (see docs/RUNBOOK.html): the page is HTTPS, this server is not.
# CLIENT_ERROR_REPORTS=false
# CLIENT_ERROR_ALLOWED_ORIGINS=https://updown.bluffking.ai   # noise filter, NOT authentication
# CLIENT_ERROR_MAX_PER_MINUTE=60      # ceiling across all callers; no IP is read or stored
# CLIENT_ERROR_MAX_SIGNATURES=32      # cardinality cap; excess still counts, breakdown is dropped
#
# How the TLS front reaches the route above. An EXTRA listener serving the same routes; the TCP
# listener is untouched and is still what the watchdog polls on 127.0.0.1. A socket is used rather
# than a port because reaching this process from the TLS front's container would otherwise mean
# binding every interface AND opening a firewall rule — both widening the surface of the process
# that holds the signing key, to expose a side-channel for error reports. Access control is the
# socket file's own permissions (0660, service user). Put it under the unit's RuntimeDirectory so
# systemd creates and cleans it.
# METRICS_SOCKET=/run/updown/keeper.sock

# Timing.
# EXECUTE_LEAD_MS=2000      # fire executeRound this long AFTER lockTs
# RELAY_LEAD_MS=12000       # budget for ONE relay before lockTs (testnet only); the lead is this
#                          # times the relay feeds sharing the boundary, since one key sends them
#                          # one at a time. Three feeds consume 36s of the contract's 50s dormant
#                          # first-bet runway; config validation reserves the other 14s for the
#                          # empty poll, both price endpoints and RPC/simulation work.
# MAX_TIMER_MS=900000       # re-read state at least this often
# IDLE_POLL_MS=1000         # cheap maintenanceRequired() poll while empty; the contract reserves
#                          # 50s of worst-path first-bet runway before a testnet boundary. A paused
#                          # market whose
#                          # previous epoch is still LOCKED is NOT idle -- it is driven on the
#                          # normal round schedule until that round settles, because executeRound
#                          # is not pausable and pause must never work as a cancel button.

# Transactions and gas.
# TX_MAX_ATTEMPTS=4
# TX_RECEIPT_TIMEOUT_MS=30000
# TX_CONFIRMATIONS=1
# GAS_BUMP_PERCENT=25
# GAS_PRICE_PREMIUM_PERCENT=10
# GAS_PRICE_GWEI=            # fixed price; unset means read from the node
# MAX_GAS_PRICE_GWEI=50
# GAS_LIMIT_PADDING_PERCENT=25
# BACKOFF_BASE_MS=750
# BACKOFF_FACTOR=2
# BACKOFF_MAX_MS=15000
# BACKOFF_JITTER=0.2

# Health and balance.
# HEALTH_INTERVALS=2         # a market may miss this many intervals before /healthz fails
# MIN_BALANCE_BNB=0.05       # warn below this. It can only ever make the keeper unhealthy EARLIER:
#                           # a balance that cannot fund one transaction at MAX_GAS_PRICE_GWEI is
#                           # reported unfunded however low this is set — 600000 gas x 50 gwei =
#                           # 0.03 BNB at the defaults. Setting this BELOW that cost gives you no
#                           # warning band at all (the keeper goes straight from ok to a 503), and
#                           # it says so at boot.
# BALANCE_POLL_MS=60000

# Safety switches.
# STRICT_RELAY_UPDATER=false # true = refuse to boot if a relay feed would reject this key
# EXIT_ON_TOTAL_BOOTSTRAP_FAILURE=false
#                           # what to do when EVERY market fails to bootstrap (a flaky or
#                           # rate-limited RPC, a wrong address). false: stay up, report /healthz
#                           # unhealthy, keep retrying — the markets come back on their own the
#                           # moment the reads succeed. true: exit 1 so a supervisor restarts.
#                           # An RPC that is unreachable ENTIRELY is caught earlier, by the chain-id
#                           # check, which exits regardless of this setting.
# DRY_RUN=false              # true = simulate and log, never broadcast
# FIND_ROUND_MAX_STEPS=64
