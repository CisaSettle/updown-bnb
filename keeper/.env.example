# ─────────────────────────────────────────────────────────────────────────────
# UpDown keeper — copy to .env and fill in. Only the first three are required.
# ─────────────────────────────────────────────────────────────────────────────

# 56 = BNB Smart Chain mainnet, 97 = BSC testnet.
CHAIN_ID=97

# JSON-RPC endpoint. Defaults to the chain's public node if left blank.
#   mainnet: https://bsc-dataseed1.bnbchain.org
#   testnet: https://data-seed-prebsc-1-s1.bnbchain.org:8545
RPC_URL=https://data-seed-prebsc-1-s1.bnbchain.org:8545

# 32-byte hex key of the keeper account (0x prefix optional).
# executeRound() is permissionless, so this key needs NO market privilege — it only needs BNB for
# gas, and on testnet it must be the `updater` of the RelayAggregator feeds (the OPERATOR address
# passed to the deploy script). NEVER put a key with funds beyond gas here.
KEEPER_PRIVATE_KEY=

# ── optional ────────────────────────────────────────────────────────────────

# Path to the deployments JSON. Default: ../contracts/deployments/<CHAIN_ID>.json
# DEPLOYMENTS_PATH=/etc/updown/97.json

# Spot price source for testnet relay feeds. No API key required.
# PRICE_API=https://api.binance.com/api/v3/ticker/price
# PRICE_API_FALLBACKS=https://data-api.binance.vision/api/v3/ticker/price
# PRICE_TIMEOUT_MS=4000
# PRICE_CACHE_TTL_MS=1500
# PRICE_MAX_DEVIATION_BPS=2000
# SYMBOL_MAP={"BTC / USD":"BTCUSDT"}

# debug | info | warn | error
# LOG_LEVEL=info

# HTTP server for /healthz and /metrics. 0 disables it.
# METRICS_PORT=9464
# METRICS_HOST=0.0.0.0

# Timing.
# EXECUTE_LEAD_MS=2000      # fire executeRound this long AFTER lockTs
# RELAY_LEAD_MS=15000       # publish the relay price this long BEFORE lockTs (testnet only)
# MAX_TIMER_MS=900000       # re-read state at least this often
# IDLE_POLL_MS=30000        # poll interval while a market is paused / not genesis-started

# Transactions and gas.
# TX_MAX_ATTEMPTS=4
# TX_RECEIPT_TIMEOUT_MS=30000
# TX_CONFIRMATIONS=1
# GAS_BUMP_PERCENT=25
# GAS_PRICE_PREMIUM_PERCENT=10
# GAS_PRICE_GWEI=            # fixed price; unset means read from the node
# MAX_GAS_PRICE_GWEI=50
# GAS_LIMIT_PADDING_PERCENT=25
# BACKOFF_BASE_MS=750
# BACKOFF_FACTOR=2
# BACKOFF_MAX_MS=15000
# BACKOFF_JITTER=0.2

# Health and balance.
# HEALTH_INTERVALS=2         # a market may miss this many intervals before /healthz fails
# MIN_BALANCE_BNB=0.05
# BALANCE_POLL_MS=60000

# Safety switches.
# STRICT_RELAY_UPDATER=false # true = refuse to boot if a relay feed would reject this key
# DRY_RUN=false              # true = simulate and log, never broadcast
# FIND_ROUND_MAX_STEPS=64
