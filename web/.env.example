# ─────────────────────────────────────────────────────────────────────────────
# UpDown web — environment
# Copy to `.env` (or `.env.local`) and edit. Every value here is OPTIONAL:
# with none of them set the app builds against BSC testnet (97) using the
# addresses in contracts/deployments/97.json, or the committed placeholder if
# that file does not exist yet.
# ─────────────────────────────────────────────────────────────────────────────

# Which chain the UI talks to. 56 = BSC mainnet, 97 = BSC testnet. Default: 97.
VITE_CHAIN_ID=97

# Override the RPC endpoint. Defaults to the public BNB Chain endpoint for the
# selected chain. Use your own (QuickNode / Ankr / NodeReal) for production.
# VITE_RPC_URL=https://bsc-testnet.example.com

# Point the build at a specific deployment JSON instead of searching for
# ../contracts/deployments/<chainId>.json. Absolute or relative to web/.
# VITE_DEPLOYMENT_FILE=./src/config/deployments.97.json

# Fail the build instead of falling back to the placeholder addresses.
# Turn this ON for any real deploy.
# STRICT_DEPLOYMENT=1

# Per-address escape hatches, applied on top of the deployment JSON at runtime.
# VITE_REGISTRY_ADDRESS=0x...
# VITE_USDT_ADDRESS=0x...

# WalletConnect is entirely optional. Leave this unset and the app ships with
# injected wallets only (MetaMask, Trust, Binance Wallet, OKX, Rabby …) and
# needs no third-party account at all.
# VITE_WALLETCONNECT_PROJECT_ID=

# Cosmetic: block explorer base URL override.
# VITE_EXPLORER_URL=https://testnet.bscscan.com
