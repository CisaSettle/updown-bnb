{
  "name": "updown-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "UpDown Protocol \u2014 static trading UI for decentralized binary options on BNB Smart Chain",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "sync:abi": "node scripts/sync-abi.mjs",
    "check:deployment": "node scripts/check-deployment.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.102.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "viem": "^2.55.19",
    "wagmi": "^2.19.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.11"
  }
}
